{
  "name": "@yivents/functions",
  "version": "0.1.0",
  "private": true,
  "description": "Yivents Cloud Functions v2 backend (europe-west2, Node 22)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "prebuild": "npm run build --workspace @yivents/shared",
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "pretypecheck": "npm run build --workspace @yivents/shared",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run build --workspace @yivents/shared",
    "test": "jest --runInBand",
    "pretest:unit": "npm run build --workspace @yivents/shared",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=/firebase/tests/",
    "serve": "firebase emulators:start --only functions,firestore,auth,storage --project yivents-demo --config ../../firebase/firebase.json"
  },
  "dependencies": {
    "@yivents/shared": "*",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.2.0",
    "firebase-functions": "^6.3.2",
    "otplib": "^12.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "firebase": "^11.6.0",
    "firebase-tools": "^14.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
