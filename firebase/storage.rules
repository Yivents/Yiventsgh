rules_version = '2';
/**
 * Uploads are always in uploads/{uid}/... Public marketing images live under
 * /public/ and are readable by anyone; payment screenshots and question
 * uploads stay private to the owner and admins. Sizes are also validated
 * server-side by an onFinalize Cloud Function.
 */
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function ownFolder(uid) { return signedIn() && request.auth.uid == uid; }
    function hasClaim(claim) { return signedIn() && request.auth.token.get(claim, false) == true; }
    function isSuperAdmin() { return hasClaim('superAdmin') || hasClaim('admin'); }
    function isAdminAny() { return isSuperAdmin() || hasClaim('support') || hasClaim('moderator'); }
    function validImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size < 6 * 1024 * 1024;
    }
    function validVideo() {
      return request.resource.contentType == 'video/mp4' && request.resource.size < 8 * 1024 * 1024;
    }

    // Registrants have no account. A trusted callable issues a random token
    // folder; only compressed images are accepted and the finalize trigger
    // revalidates them server-side.
    match /uploads/anonymous/{token}/{allPaths=**} {
      allow write: if token.matches('[A-Za-z0-9_-]{24,64}') && validImage();
      allow read: if isAdminAny();
    }
    match /uploads/{uid}/{allPaths=**} {
      allow read: if ownFolder(uid) || isAdminAny()
        || (allPaths.matches('public/.*') && resource.contentType.matches('image/(jpeg|png|webp|gif)'));
      allow write: if ownFolder(uid) && (validImage() || validVideo());
      allow delete: if ownFolder(uid) || isSuperAdmin();
    }
  }
}
