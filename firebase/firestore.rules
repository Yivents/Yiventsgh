rules_version = '2';
/**
 * Yivents Firestore rules — deny by default.
 * Public writes never touch Firestore directly: they go through callable Cloud
 * Functions using the Admin SDK (which bypasses these rules) where capacity,
 * amount, CAPTCHA and duplicate checks are enforced transactionally.
 * Admin powers come ONLY from Firebase custom claims — there is no editable
 * isAdmin/role field anywhere in the database.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ownUid(uid) { return signedIn() && request.auth.uid == uid; }
    function hasClaim(claim) { return signedIn() && request.auth.token.get(claim, false) == true; }
    function isSuperAdmin() { return hasClaim('superAdmin') || hasClaim('admin'); }
    function isSupport() { return hasClaim('support'); }
    function isModerator() { return hasClaim('moderator'); }
    function isAdminAny() { return isSuperAdmin() || isSupport() || isModerator(); }
    function programData(pid) { return get(/databases/$(database)/documents/programs/$(pid)).data; }
    function isProgramOwner(pid) { return signedIn() && programData(pid).ownerUid == request.auth.uid; }
    function isHelper(pid) {
      return signedIn() && exists(/databases/$(database)/documents/programs/$(pid)/helpers/$(request.auth.uid));
    }
    function isOwnerOrHelper(pid) { return isProgramOwner(pid) || isHelper(pid); }
    function noHiddenFields(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    /* ------------------------------ Users -------------------------------- */
    match /users/{uid} {
      allow read: if ownUid(uid) || isAdminAny();
      allow create: if ownUid(uid)
        && !request.resource.data.keys().hasAny(['admin', 'role', 'isAdmin', 'plan', 'credits']);
      allow update: if isSuperAdmin() || (ownUid(uid) && noHiddenFields(['status', 'suspensionReason', 'verifiedBadge', 'uid', 'accountType']));
      allow delete: if isSuperAdmin();
    }

    /* ---------------------------- Programs -------------------------------- */
    match /programs/{programId} {
      allow read: if isProgramOwner(programId) || isHelper(programId) || isAdminAny();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'slug', 'title', 'description', 'visibility', 'approvalStatus', 'status',
          'event', 'registrationDeadline', 'deadlineChanges', 'branding', 'slideshow', 'speakers',
          'sponsors', 'capacity', 'settings', 'counters', 'expectedReceivedPesewas',
          'scannerEnabled', 'scannerPinHash', 'createdAt', 'updatedAt'
        ]);
      allow update: if isSuperAdmin() || (isProgramOwner(programId) && noHiddenFields(['ownerUid', 'id', 'archivedAt']));
      allow delete: if isProgramOwner(programId) || isSuperAdmin();

      match /ticketTypes/{id} {
        allow read: if isOwnerOrHelper(programId) || isAdminAny();
        allow write: if isProgramOwner(programId) || isSuperAdmin();
      }
      match /formFields/{id} {
        allow read: if isOwnerOrHelper(programId) || isAdminAny();
        allow write: if isProgramOwner(programId) || isSuperAdmin();
      }
      match /feedbackFields/{id} {
        allow read: if isOwnerOrHelper(programId) || isAdminAny();
        allow write: if isProgramOwner(programId) || isSuperAdmin();
      }
      match /paymentMethods/{id} {
        allow read: if isOwnerOrHelper(programId) || isAdminAny();
        allow write: if isProgramOwner(programId) || isSuperAdmin();
      }
      match /helpers/{uid} {
        allow read: if isOwnerOrHelper(programId) || isAdminAny();
        allow write: if isProgramOwner(programId) || isSuperAdmin();
      }
      match /registrations/{registrationId} {
        allow read: if isOwnerOrHelper(programId) || isAdminAny();
        // Submission, approval, cancellation and check-in are callable-only.
        allow create: if false;
        allow update: if isAdminAny() || (isOwnerOrHelper(programId)
          && noHiddenFields(['status', 'ticketCode', 'ticketTypeId', 'ticketPricePesewas', 'payment', 'checkedInAt', 'checkedInBy', 'contact']));
        allow delete: if isProgramOwner(programId) || isSuperAdmin();
      }
      // Everything below is written by trusted server code only.
      match /auditLogs/{id} {
        allow read: if isProgramOwner(programId) || isAdminAny();
        allow write: if false;
      }
      match /checkInLogs/{id} {
        allow read: if isOwnerOrHelper(programId) || isAdminAny();
        allow write: if false;
      }
      match /joinClicks/{id} {
        allow read: if isProgramOwner(programId) || isAdminAny();
        allow write: if false;
      }
      match /feedback/{id} {
        allow read: if isOwnerOrHelper(programId) || isAdminAny();
        allow write: if false;
      }
      match /waitlist/{id} {
        allow read: if isOwnerOrHelper(programId) || isAdminAny();
        allow write: if false;
      }
    }

    /* ------------------------ Public projections -------------------------- */
    // Slug is the capability for link-only events. `list` is denied so nobody
    // can enumerate events that were not publicly listed.
    match /publicPrograms/{slug} {
      allow get: if resource.data.status != 'archived';
      allow list: if false;
      allow write: if false;
    }
    match /publicListings/{programId} {
      allow get, list: if resource.data.approvalStatus == 'approved'
        && resource.data.status in ['upcoming', 'ongoing'];
      allow write: if false;
    }

    /* -------------------------- Ticket lookup ----------------------------- */
    // Ticket codes are long random strings. All access goes through the
    // rate-limited callable lookupTicket / checkIn functions.
    match /tickets/{code} {
      allow read, write: if false;
    }

    /* ---------------------------- Settings -------------------------------- */
    match /settings/{id} {
      allow read: if isAdminAny();
      allow write: if isSuperAdmin();
    }
    match /publicSettings/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    /* --------------------------- Announcements ---------------------------- */
    match /announcements/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    /* ------------------------- Content / legal ---------------------------- */
    match /contentPages/{slug} {
      allow read: if true;
      allow write: if isSuperAdmin();
      match /versions/{version} {
        allow read: if isSuperAdmin();
        allow write: if isSuperAdmin();
      }
    }
    match /contentAcceptances/{uid}/{slug} {
      allow read: if ownUid(uid) || isAdminAny();
      allow write: if ownUid(uid);
    }

    /* ----------------------- Admin messaging ------------------------------ */
    match /conversations/{orgId} {
      allow read: if (signedIn() && resource.data.organizerUid == request.auth.uid) || isAdminAny();
      allow create: if signedIn() && orgId == request.auth.uid && request.resource.data.organizerUid == request.auth.uid;
      allow update: if isAdminAny() || (signedIn() && resource.data.organizerUid == request.auth.uid);
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if isAdminAny() || (signedIn() && get(/databases/$(database)/documents/conversations/$(orgId)).data.organizerUid == request.auth.uid);
        allow create: if signedIn() && (isAdminAny() || get(/databases/$(database)/documents/conversations/$(orgId)).data.organizerUid == request.auth.uid);
        allow update: if isAdminAny() || (signedIn() && get(/databases/$(database)/documents/conversations/$(orgId)).data.organizerUid == request.auth.uid);
        allow delete: if false;
      }
    }

    /* ------------------------- Reports / abuse ---------------------------- */
    match /reports/{id} {
      allow create: if request.resource.data.keys().hasOnly(['programId', 'reason', 'details', 'contact', 'status', 'createdAt'])
        && request.resource.data.status == 'open';
      allow read: if isAdminAny() || (signedIn() && isProgramOwner(resource.data.programId));
      allow update: if isAdminAny();
      allow delete: if isSuperAdmin();
    }

    /* ------------------ Server-only admin/ops collections ----------------- */
    match /blocklist/{id} {
      allow read: if isAdminAny();
      allow write: if isSuperAdmin();
    }
    match /auditLogs/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    match /rateLimits/{key} { allow read, write: if false; }
    match /metrics/{id} {
      allow read: if isAdminAny();
      allow write: if false;
    }
  }
}
